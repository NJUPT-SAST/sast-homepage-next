# Docker build context ignore file.
# Keep this at least as strict as .gitignore so local-only files are not sent
# to the Docker daemon during image builds.

# Dependencies and package-manager state.
node_modules
/node_modules
.pnp
.pnp.*
.yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing and local reports.
coverage
/coverage
.playwright-mcp
/.playwright-mcp
playwright-report
test-results

# Next.js / production build output.
.next
/.next
out
/out
build
/build
next-env.d.ts
*.tsbuildinfo

# Environment files and secrets.
# .env is provided to the Docker build as a BuildKit secret, not copied.
.env
.env.*
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Vercel and deployment-local state.
.vercel
.vercel/*

# Git and repository metadata.
.git
.git/*
.gitignore
.gitattributes

# Editor / IDE / OS noise.
.vscode
.vscode/*
.idea
.idea/*
.DS_Store
Thumbs.db
desktop.ini

# Logs and package-manager debug output.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docker / local compose override files that should not be copied into app code.
docker-compose.override.yml
compose.override.yml

# Misc local caches.
.cache
.cache/*
.turbo
.turbo/*
.eslintcache
